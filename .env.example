# Backend environment variables for vibecraft.
#
# Copy this file to `.env` in the repo root (gitignored, never commit it). `application.yaml` loads it
# automatically via `spring.config.import: optional:file:.env[.properties]` — no extra tooling needed.
# Every value below is a bare placeholder with NO working default in `application.yaml`: a missing one fails
# startup instead of silently running on a fallback. That's deliberate (this repo is public) — don't "fix" a
# missing var by adding a default back into application.yaml.
#
# The frontend has its own `frontend/.env.example` — copy that separately to `frontend/.env.local`.

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Matches services.docker-compose.yml's `pgvector` service (port 9010 on the host). The connection URL itself
# is hardcoded in application.yaml since it's not a secret; only the credentials come from here.
DB_USERNAME=user
DB_PASSWORD=password

# ── Legacy JWT signing key ───────────────────────────────────────────────────
# Only used by the legacy Bearer-token auth path (LegacyAuthController, app.auth.legacy.enabled: true). Any
# long random string works locally — this is a rollback path, not the primary sign-in method (see Firebase below).
JWT_SECRET=replace-with-any-long-random-string

# ── Firebase Authentication (primary sign-in) ────────────────────────────────
# Every sign-in method (password, Google, two-step codes) happens against Firebase from the browser; this
# server only ever verifies the resulting ID token. Get both from the Firebase console.
#   FIREBASE_PROJECT_ID       - Project settings -> General -> Project ID
#   FIREBASE_CREDENTIALS_PATH - Project settings -> Service accounts -> Generate new private key -> a JSON file
#                                path OUTSIDE this repo. It can mint tokens for any user in the project — never
#                                commit it, never put it inside a directory git tracks.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# ── AI generation (OpenRouter, OpenAI-compatible API) ────────────────────────
# Powers AI chat generation (ChatController), the idea clarifier (IdeaController), code insight/code notes
# (CodeInsightController), and project naming. https://openrouter.ai — free-tier keys work but are rate-limited.
OPENROUTER_API_KEY=

# ── Object storage (MinIO — project files) ───────────────────────────────────
# Matches services.docker-compose.yml's `minio` service (API on 9000, console on 9001). Must match whatever
# you actually run MinIO with locally.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ── Stripe (billing) ──────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys. Without these, everything except billing
# still works (Free-plan quotas are seeded regardless — see docs/schema/'s PLAN section).
STRIPE_SECRET=
# From the Stripe CLI (`stripe listen --forward-to localhost:8080/webhooks/payment`) or a configured webhook
# endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs for the two paid plans (Pro, Business) — create these as Stripe Prices first, then paste
# their ids here. PlanSeeder upserts the plan catalogue against these on every boot.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── Internal service-to-service auth (microservices migration) ──────────────
# Two DISTINCT secrets, both new as of the microservices migration's Phase 0/1, neither shared with any third
# party — generate your own random strings, they just need to match across every service that reads them.
#   INTERNAL_JWT_SECRET             - signs the short-lived internal JWT gateway-service will mint per request
#                                      once it takes over auth for an extracted service (not yet exercised —
#                                      see docs/migration/). Every service depending on common-lib needs
#                                      this bound at startup regardless, since common-lib's auto-configuration
#                                      creates the signing bean unconditionally.
#   INTERNAL_SERVICE_SHARED_SECRET  - guards every service's /internal/v1/** API (service-to-service only,
#                                      never routed through the Gateway) — see common-lib's
#                                      InternalServiceAuthFilter.
INTERNAL_JWT_SECRET=replace-with-any-long-random-string
INTERNAL_SERVICE_SHARED_SECRET=replace-with-a-different-long-random-string

# ── Live previews (Kubernetes + Redis) ───────────────────────────────────────
# Only needed to actually start a live preview — every other feature works without a cluster running. See
# docs/local-development/'s "Live previews" section for the full kind/k8s/Redis setup. No env var here:
# preview.* config lives entirely in application.yaml (namespace, ports, timeouts) since none of it is secret.
# Redis itself (spring.data.redis.host/port) also has no env var — it's hardcoded to localhost:6379, reached
# either directly (a cluster running alongside the backend) or forwarded (k8s/dev-port-forward.sh/.ps1, or set
# preview.port-forward.enabled: true in application.yaml to have the backend forward it itself).
