# Copy to .env.local (gitignored) and fill in from Firebase console -> Project settings -> General -> Your apps (Web).
# None of these are secrets: they identify the Firebase project to the browser. All four are required - Firebase is the
# only sign-in method, so the app can't sign anyone in without them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Production builds only: origins live project previews are served from (space-separated), allowed in the CSP's frame-src.
VITE_CSP_FRAME_ORIGINS=

# Production builds only: set to `true` while payments run against Stripe test keys, which makes the pricing and billing
# pages show a "test mode, use card 4242 4242 4242 4242" note (src/lib/payments-mode.ts). Leave empty otherwise.
VITE_PAYMENTS_TEST_MODE=
