# Copy to .env.local (gitignored) and fill in from Firebase console -> Project settings -> General -> Your apps (Web).
# None of these are secrets: they identify the Firebase project to the browser. Leave them empty and the app falls back
# to the legacy username/password sign-in (only while the backend's app.auth.legacy.enabled is true).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Production builds only: origins live project previews are served from (space-separated), allowed in the CSP's frame-src.
VITE_CSP_FRAME_ORIGINS=
