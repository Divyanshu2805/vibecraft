<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.vibecraft</groupId>
		<artifactId>vibecraft-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>gateway-service</artifactId>
	<name>gateway-service</name>
	<description>
		The single origin the browser (and the frontend's Vite dev proxy) talks to. Reactive (WebFlux/Netty),
		deliberately — a blocking gateway would buffer the two SSE streams (/api/chat/stream, /code/*/stream)
		instead of forwarding them chunk by chunk. Transparent passthrough with no auth logic of its own:
		every service runs its own Firebase/session/CSRF chain. Routes each domain to its service
		(account/workspace/intelligence, via Eureka) — see this module's routing config, and RoutingTableTest
		for the exact path-to-service table.
	</description>

	<dependencies>
		<!-- Reactive/WebFlux Gateway (non-blocking — required so SSE streams pass through unbuffered).
		     Renamed from spring-cloud-starter-gateway as of the 2025.0 release train; -server-webmvc is the
		     newer blocking sibling, deliberately not used here. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>

		<!-- RoutingTableTest boots the Gateway's context (no server, no Eureka) to evaluate the real route
		     table. Unlike the other services this needs no database, so the Windows-timezone reason those
		     modules avoid @SpringBootTest doesn't apply here. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
